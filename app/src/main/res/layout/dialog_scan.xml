<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="6dp"
    android:paddingEnd="22dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/titleBox"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Titel">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/scanTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        style="@style/SettingsLabel"
        android:text="Wie viele Fotos ergeben eine Buchseite?" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/groupParts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/parts1"
            style="@style/SegButton"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/parts2"
            style="@style/SegButton"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/parts3"
            style="@style/SegButton"
            android:text="3" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/partsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />
</LinearLayout>
